{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bachan-gar-api",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bachan-gas-db",
      "database_id": "1ce5946b-e274-487a-86a4-19bb51d6bfe1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "bachan-gas-assets"
    }
  ]
}
