{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bachan-gas-api",
  "main": "server/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bachan-gas-db",
      "database_id": "bachan-gas-db-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "bachan-gas-assets"
    }
  ]
}
